{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Northweb Studio brand tokens. Light mode follows the supplied brand guide; dark mode is a derived counterpart. Edit this file, not generated theme files.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FFFFFF" },
      "foreground": { "$value": "#2F3E46" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#2F3E46" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#2F3E46" },
      "primary": { "$value": "#F26522", "$description": "Northweb orange; primary calls to action and interaction accents." },
      "primaryForeground": { "$value": "#111111", "$description": "High-contrast ink on orange and its hover shade; the guide's white-on-orange combination does not meet AA for normal-size text." },
      "secondary": { "$value": "#4CAF50", "$description": "Northweb green; use sparingly for supporting accents and positive states." },
      "secondaryForeground": { "$value": "#171D21" },
      "accent": { "$value": "#2F3E46", "$description": "Charcoal for dark editorial surfaces." },
      "accentForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#F7F9FA" },
      "mutedForeground": { "$value": "#6B7884" },
      "destructive": { "$value": "#B42318" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "border": { "$value": "#E9EEF2" },
      "input": { "$value": "#CBD5DA" },
      "ring": { "$value": "#F26522" },
      "chart1": { "$value": "#F26522" },
      "chart2": { "$value": "#4CAF50" },
      "chart3": { "$value": "#2F3E46" },
      "chart4": { "$value": "#6B7884" },
      "chart5": { "$value": "#3D829E" },
      "sidebar": { "$value": "#F7F9FA" },
      "sidebarForeground": { "$value": "#2F3E46" },
      "sidebarBorder": { "$value": "#E9EEF2" },
      "sidebarPrimary": { "$value": "#F26522" },
      "sidebarPrimaryForeground": { "$value": "#111111" },
      "sidebarAccent": { "$value": "#E9EEF2" },
      "sidebarAccentForeground": { "$value": "#2F3E46" },
      "sidebarRing": { "$value": "#F26522" }
    },
    "dark": {
      "background": { "$value": "#1C272D" },
      "foreground": { "$value": "#F7F9FA" },
      "card": { "$value": "#26353C" },
      "cardForeground": { "$value": "#FFFFFF" },
      "popover": { "$value": "#2F3E46" },
      "popoverForeground": { "$value": "#FFFFFF" },
      "primary": { "$value": "#F26522" },
      "primaryForeground": { "$value": "#111111" },
      "secondary": { "$value": "#4CAF50" },
      "secondaryForeground": { "$value": "#171D21" },
      "accent": { "$value": "#43525B" },
      "accentForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#35454E" },
      "mutedForeground": { "$value": "#D2DCE0" },
      "destructive": { "$value": "#F16A5B" },
      "destructiveForeground": { "$value": "#171D21" },
      "border": { "$value": "#43525B" },
      "input": { "$value": "#6B7884" },
      "ring": { "$value": "#F26522" },
      "chart1": { "$value": "#F26522" },
      "chart2": { "$value": "#6FCF76" },
      "chart3": { "$value": "#D2DCE0" },
      "chart4": { "$value": "#91A2AD" },
      "chart5": { "$value": "#6CA6BE" },
      "sidebar": { "$value": "#202D33" },
      "sidebarForeground": { "$value": "#F7F9FA" },
      "sidebarBorder": { "$value": "#43525B" },
      "sidebarPrimary": { "$value": "#F26522" },
      "sidebarPrimaryForeground": { "$value": "#111111" },
      "sidebarAccent": { "$value": "#2F3E46" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing": { "$value": "#F26522" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "sans-serif"], "$description": "Navigation, UI, forms, and body copy." },
      "serif": { "$value": ["Merriweather", "serif"], "$description": "Editorial display moments only." },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.5rem", "$description": "8px button radius. Cards use the derived 16px xl radius." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "4px base unit." }
  }
}