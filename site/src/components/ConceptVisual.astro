---
interface Props {
  variant: 'site' | 'shop' | 'app';
  class?: string;
}
const { variant, class: className } = Astro.props;
---

<div aria-hidden="true" class:list={['relative overflow-hidden rounded-md border border-charcoal/10 bg-gray-100', className]}>
  <div class="absolute inset-x-5 top-5 bottom-0 overflow-hidden rounded-t-md border border-b-0 border-charcoal/15 bg-white shadow-md md:inset-x-8 md:top-8">
    <div class="flex items-center gap-1.5 border-b border-gray-100 px-3 py-2">
      <span class="h-2 w-2 rounded-full bg-gray-100"></span><span class="h-2 w-2 rounded-full bg-gray-100"></span><span class="h-2 w-2 rounded-full bg-gray-100"></span>
      <span class="ml-3 h-2 w-1/3 rounded-sm bg-gray-100"></span>
    </div>
    {variant === 'site' && (
      <div class="grid gap-4 p-4 md:grid-cols-5 md:p-6">
        <div class="md:col-span-3">
          <span class="block h-2 w-12 rounded-sm bg-primary"></span>
          <span class="mt-4 block h-4 w-11/12 rounded-sm bg-charcoal"></span>
          <span class="mt-2 block h-4 w-8/12 rounded-sm bg-charcoal"></span>
          <span class="mt-4 block h-2 w-10/12 rounded-sm bg-gray-100"></span>
          <span class="mt-2 block h-2 w-7/12 rounded-sm bg-gray-100"></span>
          <span class="mt-5 block h-6 w-24 rounded-sm bg-primary"></span>
        </div>
        <span class="hidden h-32 rounded-sm bg-charcoal md:col-span-2 md:block"></span>
      </div>
    )}
    {variant === 'shop' && (
      <div class="grid grid-cols-3 gap-3 p-4">
        {[0, 1, 2].map((i) => (
          <div>
            <span class:list={['block h-16 rounded-sm md:h-24', i === 1 ? 'bg-charcoal' : 'bg-gray-100']}></span>
            <span class="mt-2 block h-2 w-3/4 rounded-sm bg-charcoal/70"></span>
            <span class="mt-1.5 block h-2 w-1/3 rounded-sm bg-primary"></span>
          </div>
        ))}
      </div>
    )}
    {variant === 'app' && (
      <div class="grid grid-cols-[28%_1fr] gap-3 p-4">
        <div class="space-y-2">
          <span class="block h-2 w-full rounded-sm bg-primary"></span>
          <span class="block h-2 w-4/5 rounded-sm bg-gray-100"></span>
          <span class="block h-2 w-3/5 rounded-sm bg-gray-100"></span>
        </div>
        <div class="space-y-2">
          {[0, 1, 2, 3].map(() => (
            <span class="flex items-center gap-2 border-b border-gray-100 pb-2"><span class="h-2 w-2 rounded-sm bg-charcoal"></span><span class="h-2 w-2/3 rounded-sm bg-gray-100"></span></span>
          ))}
        </div>
      </div>
    )}
  </div>
</div>
