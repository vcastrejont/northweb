---
import Container from './Container.astro';

const nav = [
  { label: 'Servicios', href: '#servicios' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Proceso', href: '#proceso' },
  { label: 'Nosotros', href: '#nosotros' },
  { label: 'Blog', pending: true },
];
const services = ['Sitios web', 'E-commerce', 'CRM y sistemas', 'Aplicaciones web'];
const social = ['LinkedIn', 'Instagram'];
const linkClass = 'inline-flex min-h-11 items-center text-sm text-white/80 transition-colors duration-200 hover:text-white hover:underline';
const pendingClass = 'inline-flex min-h-11 items-center text-sm text-white/70';
---

<footer class="bg-charcoal text-white">
  <Container class="py-16 md:py-20">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4 md:gap-y-12 lg:grid-cols-12">
      <div data-reveal class="col-span-2 md:col-span-4 lg:col-span-4">
        <a href="/" class="inline-flex min-h-11 items-center">
          <img src="/northweb-logo-light.svg" width="200" height="60" alt="Northweb Studio" class="h-auto w-44" />
        </a>
        <p class="mt-4 text-sm text-white/80">Diseño y desarrollo digital</p>
      </div>

      <nav data-reveal data-reveal-item="1" aria-labelledby="footer-nav" class="col-span-1 md:col-span-2 lg:col-span-2 lg:col-start-6">
        <h2 id="footer-nav" class="text-xs font-semibold tracking-[0.08em] text-white/70">NAVEGACIÓN</h2>
        <ul class="mt-3">
          {nav.map((item) => (
            <li>
              {item.pending
                ? <span class={pendingClass}>{item.label} <span class="ml-2 text-xs">(próximamente)</span></span>
                : <a class={linkClass} href={item.href}>{item.label}</a>}
            </li>
          ))}
        </ul>
      </nav>

      <div data-reveal data-reveal-item="2" class="col-span-1 md:col-span-2 lg:col-span-2">
        <h2 class="text-xs font-semibold tracking-[0.08em] text-white/70">SERVICIOS</h2>
        <ul class="mt-3">
          {services.map((s) => <li><a class={linkClass} href="#servicios">{s}</a></li>)}
        </ul>
      </div>

      <div data-reveal data-reveal-item="3" class="col-span-2 md:col-span-4 lg:col-span-3">
        <h2 class="text-xs font-semibold tracking-[0.08em] text-white/70">CONTACTO</h2>
        <a href="#contacto" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-white underline decoration-primary decoration-2 underline-offset-4 hover:text-white/80">
          <span>Hablemos de tu proyecto</span><span aria-hidden="true" class="ml-2 text-primary">→</span>
        </a>
        <ul class="mt-2 flex flex-wrap gap-x-5" aria-label="Redes sociales, pendientes">
          {social.map((s) => <li><span class={pendingClass}>{s} <span class="ml-1 text-xs">(pendiente)</span></span></li>)}
        </ul>
      </div>
    </div>

    <div data-reveal class="mt-12 flex flex-col gap-2 border-t border-white/20 pt-6 text-sm text-white/70 sm:flex-row sm:items-center sm:justify-between">
      <p>© Northweb Studio</p>
      <p>Aviso de privacidad <span class="text-xs">(pendiente de publicación)</span></p>
    </div>
  </Container>
</footer>
