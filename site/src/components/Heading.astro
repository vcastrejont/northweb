---
interface Props {
  level?: 1 | 2 | 3 | 4;
  display?: boolean;
  font?: 'sans' | 'display';
  class?: string;
}

const { level = 2, display = false, font = 'sans', class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';
const sizes = {
  1: 'text-[40px] leading-[1.1] md:text-[56px] md:leading-[1.08]',
  2: 'text-[32px] leading-[1.15] md:text-[44px] md:leading-[1.12]',
  3: 'text-[26px] leading-[1.2] md:text-[32px]',
  4: 'text-2xl leading-[1.3]',
};
const displaySize = 'text-[44px] leading-[1.08] md:text-[72px] md:leading-[1.05]';
---

<Tag class:list={[display || font === 'display' ? 'font-display' : 'font-sans', 'font-bold text-charcoal', display ? displaySize : sizes[level], className]}>
  <slot />
</Tag>
