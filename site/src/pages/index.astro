---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../sections/Hero.astro';
import ClientLogos from '../sections/ClientLogos.astro';
import Services from '../sections/Services.astro';
import Projects from '../sections/Projects.astro';
import WhyNorthweb from '../sections/WhyNorthweb.astro';
import Process from '../sections/Process.astro';
import FinalCTA from '../sections/FinalCTA.astro';
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <ClientLogos />
    <Services />
    <Process />
    <Projects />
    <WhyNorthweb />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>

<script>
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const supportsIntersectionObserver = 'IntersectionObserver' in window;

  if (!motionPreference.matches && supportsIntersectionObserver) {
    const revealTargets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    let observer: IntersectionObserver | undefined;

    const showAll = () => {
      document.documentElement.classList.remove('nw-motion-ready');
      observer?.disconnect();
      revealTargets.forEach((target) => target.classList.add('is-visible'));
    };

    try {
      observer = new IntersectionObserver(
        (entries) => {
          try {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                target.classList.add('is-visible');
                observer?.unobserve(target);
              }
            });
          } catch {
            showAll();
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -32px 0px' },
      );

      revealTargets.forEach((target) => observer?.observe(target));

      document.documentElement.classList.add('nw-motion-ready');

      motionPreference.addEventListener('change', (event) => {
        if (event.matches) showAll();
      });
    } catch {
      showAll();
    }
  }
</script>
