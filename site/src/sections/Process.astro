---
import Heading from '../components/Heading.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';

const steps = [
  {
    number: '01',
    title: 'Entendemos',
    description: 'Conocemos tu negocio, tus objetivos y las necesidades de tus usuarios.',
    icon: 'M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V5Z',
  },
  {
    number: '02',
    title: 'Definimos',
    description: 'Acordamos el alcance, las prioridades y un plan claro para avanzar.',
    icon: 'M12 3v18M3 12h18M5 5l14 14M19 5 5 19',
  },
  {
    number: '03',
    title: 'Diseñamos y desarrollamos',
    description: 'Convertimos la estrategia en una experiencia digital útil, accesible y rápida.',
    icon: 'M14 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M14 4v6h6M14 4l6 6M8 13h8M8 17h5',
  },
  {
    number: '04',
    title: 'Lanzamos y mejoramos',
    description: 'Publicamos, medimos y seguimos mejorando según las necesidades del proyecto.',
    icon: 'M13 2 3 14l7 1 1 7 10-12-8-8ZM10 15l4-4',
  },
];
---

<Section id="proceso">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="text-xs font-semibold tracking-[0.08em] text-primary">PROCESO</p>
      <Heading level={2} font="display" class="mt-4 max-w-2xl">Así convertimos una idea en una solución digital.</Heading>
    </div>
    <p class="max-w-xl text-base leading-relaxed text-slate lg:col-span-5 lg:pb-1">
      Trabajamos de forma cercana y ordenada para convertir tus objetivos en una solución que realmente funcione para tu negocio.
    </p>
  </div>

  <ol class="mt-12 grid gap-8 md:grid-cols-2 xl:grid-cols-4 xl:gap-6">
    {steps.map(({ number, title, description, icon }) => (
      <li class="border-t border-gray-100 pt-6">
        <div class="flex items-center justify-between gap-4">
          <span class="font-display text-4xl leading-none text-primary">{number}</span>
          <span class="grid h-11 w-11 place-items-center rounded-md border border-gray-100 text-charcoal">
            <Icon path={icon} size={22} />
          </span>
        </div>
        <Heading level={3} class="mt-7 text-[26px]">{title}</Heading>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate">{description}</p>
      </li>
    ))}
  </ol>
</Section>
