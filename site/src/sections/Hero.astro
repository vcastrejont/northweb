---
import Button from '../components/Button.astro';
import Heading from '../components/Heading.astro';
import Container from '../components/Container.astro';
---

<section class="hero relative isolate overflow-hidden bg-charcoal pt-16 pb-80 text-white md:pt-24 md:pb-28 xl:pt-32 xl:pb-36">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <img
      src="/images/northweb-hero-studio.webp"
      alt=""
      width="1024"
      height="590"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-x-0 bottom-0 h-[22rem] w-full object-cover object-[72%_center] md:inset-0 md:h-full md:object-[right_center]"
    />
    <div class="absolute inset-x-0 bottom-0 h-[22rem] bg-gradient-to-b from-charcoal via-charcoal/20 to-transparent md:hidden"></div>
    <div class="absolute inset-0 hidden bg-gradient-to-r from-charcoal/95 via-charcoal/60 to-transparent md:block"></div>
  </div>
  <Container>
    <div class="max-w-[640px]">
      <p data-reveal="hero" data-reveal-order="0" class="text-xs font-semibold tracking-[0.08em] text-primary">DISEÑO Y DESARROLLO DIGITAL</p>
      <Heading level={1} font="display" class="hero-title mt-5" data-reveal="hero" data-reveal-order="1">
        Tu negocio merece<br class="hidden lg:block" />
        una presencia que <span class="text-primary">venda</span><br class="hidden lg:block" />
        por ti.
      </Heading>
      <p data-reveal="hero" data-reveal-order="2" class="mt-6 max-w-xl text-lg leading-[1.55] text-gray-100 md:text-xl">
        Diseñamos y desarrollamos sitios web, e-commerce y sistemas digitales que ayudan a tu empresa a trabajar mejor y crecer.
      </p>
      <div data-reveal="hero" data-reveal-order="3" class="mt-8">
        <Button href="#contacto"><span>Hablemos de tu proyecto</span><span aria-hidden="true" class="ml-2">→</span></Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero :global(.hero-title) {
    color: var(--nw-color-white);
  }
</style>
