---
import Button from '../components/Button.astro';
import Heading from '../components/Heading.astro';
import HeroBackground from '../components/HeroBackground.astro';
import Section from '../components/Section.astro';
---

<Section class="overflow-hidden pt-12 pb-8 md:pt-16 md:pb-12 xl:pt-20 xl:pb-14">
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-6">
      <p class="text-xs font-semibold tracking-[0.08em] text-primary">DISEÑO Y DESARROLLO DIGITAL</p>
      <Heading level={1} font="display" class="mt-5 max-w-[690px]">
        Soluciones digitales<br class="hidden lg:block" />
        para <span class="text-primary">hacer crecer</span><br class="hidden lg:block" />
        tu negocio.
      </Heading>
      <p class="mt-6 max-w-xl text-lg leading-[1.55] text-slate md:text-xl">
        Diseñamos y desarrollamos sitios web, e-commerce y sistemas digitales que ayudan a las empresas a trabajar mejor y crecer.
      </p>
      <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6">
        <Button href="#contacto"><span>Hablemos de tu proyecto</span><span aria-hidden="true" class="ml-2">→</span></Button>
        <Button href="#proyectos" variant="text"><span>Ver proyectos</span><span aria-hidden="true" class="ml-2">→</span></Button>
      </div>
    </div>

    <div class="lg:col-span-6">
      <HeroBackground />
    </div>
  </div>
</Section>
