---
import ConceptVisual from '../components/ConceptVisual.astro';
import Heading from '../components/Heading.astro';
import Section from '../components/Section.astro';

type Project = {
  number: string;
  category: string;
  variant: 'site' | 'shop' | 'app';
  featured: boolean;
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  imageCaption: string;
  detailsLabel: string;
  details: string;
  href?: string;
};

const projects: Project[] = [
  {
    number: '01',
    category: 'Salud ocupacional',
    variant: 'site',
    featured: true,
    title: 'SIEM.care',
    description: 'SIEM ofrece medicina del trabajo, evaluaciones médicas laborales, atención en sitio, estudios periódicos y asesoría en cumplimiento normativo para empresas.',
    image: '/images/siem-homepage.webp',
    imageWidth: 1626,
    imageHeight: 1208,
    imageAlt: 'Página de inicio de SIEM.care, con información sobre salud ocupacional para empresas.',
    imageCaption: 'Vista de la página de inicio de SIEM.care.',
    detailsLabel: 'Conocer SIEM',
    details: 'SIEM (Salud Industrial y Empresarial Mexicana) también brinda unidades médicas móviles y capacitación en seguridad industrial con registro DC5 y constancias DC3.',
    href: 'https://www.siem.care/',
  },
  {
    number: '02',
    category: 'Mantenimiento integral',
    variant: 'shop',
    featured: false,
    title: 'Lidex',
    description: 'Lidex ofrece servicios de mantenimiento para hogares y negocios de Hermosillo, como fumigación, jardinería y cuidado de albercas.',
    image: '/images/lidex-homepage.webp',
    imageWidth: 1200,
    imageHeight: 675,
    imageAlt: 'Página de inicio de Lidex.mx con servicios de mantenimiento y fotografía de una vivienda.',
    imageCaption: 'Miniatura de la página de inicio de lidex.mx.',
    detailsLabel: 'Conocer Lidex',
    details: 'Su catálogo también incluye pintura, reparaciones menores y mantenimiento preventivo general. El sitio permite solicitar una cotización.',
    href: 'https://lidex.mx/',
  },
  {
    number: '03',
    category: 'Salud ocupacional / Sistema en desarrollo',
    variant: 'app',
    featured: false,
    title: 'SIEM — Sistema de expedientes y citas para salud ocupacional (en desarrollo)',
    description: 'Rediseño y reconstrucción de la plataforma de gestión de pacientes de SIEM, clínica de salud ocupacional en Hermosillo con tres sucursales.',
    image: '/images/siem-dashboard.png',
    imageWidth: 1625,
    imageHeight: 1090,
    imageAlt: 'Panel de citas de SIEM con calendario mensual y agenda de citas del día.',
    imageCaption: 'Panel de citas de la plataforma de gestión de pacientes de SIEM.',
    detailsLabel: 'Estado del proyecto',
    details: 'En desarrollo para SIEM, clínica de salud ocupacional en Hermosillo con tres sucursales.',
    href: undefined,
  },
];
---

<Section id="proyectos">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
    <div data-reveal class="lg:col-span-7">
      <p class="border-l-2 border-primary pl-3 text-xs font-semibold tracking-[0.08em] text-charcoal">PROYECTOS</p>
      <Heading level={2} font="display" class="mt-4 max-w-2xl">Últimos proyectos</Heading>
    </div>
    <p data-reveal class="max-w-xl text-base leading-relaxed text-slate lg:col-span-5 lg:pb-1">
      Diseñamos y construimos experiencias digitales pensadas para personas y negocios reales.
    </p>
  </div>

  <div class="mt-12 grid gap-x-6 gap-y-14 md:grid-cols-2">
    {projects.map((p, index) => (
      <article data-reveal data-reveal-item={index} class:list={['flex flex-col', p.featured && 'md:col-span-2 md:grid md:grid-cols-12 md:gap-x-6']}>
        <div class:list={[p.featured && 'md:col-span-8']}>
          {p.image ? (
            <img
              src={p.image}
              alt={p.imageAlt ?? ''}
              width={p.imageWidth}
              height={p.imageHeight}
              loading="lazy"
              decoding="async"
              class:list={['w-full rounded-md border border-charcoal/10 object-cover object-top', p.featured ? 'h-64 md:h-[420px]' : 'h-56 md:h-72']}
            />
          ) : (
            <ConceptVisual variant={p.variant} class:list={[p.featured ? 'h-64 md:h-[420px]' : 'h-56 md:h-72']} />
          )}
          <p class="mt-2 text-xs text-slate">{p.imageCaption}</p>
        </div>
        <div class:list={['mt-6 flex flex-col', p.featured && 'md:col-span-4 md:mt-0 md:justify-end']}>
          <div class="flex items-center gap-3 border-t border-charcoal pt-4 text-xs font-semibold tracking-[0.08em] text-charcoal">
            <span class="tabular-nums">{p.number}</span>
            <span class="text-slate" aria-hidden="true">/</span>
            <span class="uppercase">{p.category}</span>
          </div>
          <Heading level={3} font="display" class:list={['mt-4', p.featured ? 'md:text-[32px]' : 'text-2xl md:text-2xl']}>{p.title}</Heading>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate">{p.description}</p>
          <details class="group mt-4">
            <summary class="inline-flex min-h-11 cursor-pointer list-none items-center text-sm font-semibold text-charcoal underline decoration-primary decoration-2 underline-offset-4 transition-colors duration-200 hover:text-primary-hover [&::-webkit-details-marker]:hidden">
              <span>{p.detailsLabel} <span class="sr-only">{p.number}</span></span><span aria-hidden="true" class="ml-2 text-primary">→</span>
            </summary>
            <p class="mt-2 max-w-sm border-l-2 border-primary pl-4 text-sm leading-relaxed text-charcoal">
              {p.details}
            </p>
            {p.href && (
              <a
                class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary underline decoration-primary decoration-2 underline-offset-4 transition-colors duration-200 hover:text-primary-hover"
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                Visitar sitio oficial <span class="sr-only">(abre una pestaña nueva)</span><span aria-hidden="true" class="ml-2">↗</span>
              </a>
            )}
          </details>
        </div>
      </article>
    ))}
  </div>
</Section>
