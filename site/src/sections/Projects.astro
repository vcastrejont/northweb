---
import ConceptVisual from '../components/ConceptVisual.astro';
import Heading from '../components/Heading.astro';
import Section from '../components/Section.astro';

const projects = [
  { number: '01', category: 'Sitio web', variant: 'site', featured: true, title: 'Proyecto 01', description: 'Espacio reservado para un sitio web con estructura clara, lectura cómoda y una presencia visual cuidada.' },
  { number: '02', category: 'E-commerce', variant: 'shop', featured: false, title: 'Proyecto 02', description: 'Espacio reservado para una tienda en línea con catálogo simple y compra directa.' },
  { number: '03', category: 'Sistema / Aplicación web', variant: 'app', featured: false, title: 'Proyecto 03', description: 'Espacio reservado para una herramienta a la medida que ordena procesos internos.' },
] as const;
---

<Section id="proyectos">
  <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <p class="border-l-2 border-primary pl-3 text-xs font-semibold tracking-[0.08em] text-charcoal">PROYECTOS</p>
      <Heading level={2} font="display" class="mt-4 max-w-2xl">Proyectos seleccionados</Heading>
    </div>
    <p class="max-w-xl text-base leading-relaxed text-slate lg:col-span-5 lg:pb-1">
      Diseñamos y construimos experiencias digitales pensadas para personas y negocios reales.
    </p>
  </div>

  <div class="mt-12 grid gap-x-6 gap-y-14 md:grid-cols-2">
    {projects.map((p) => (
      <article class:list={['flex flex-col', p.featured && 'md:col-span-2 md:grid md:grid-cols-12 md:gap-x-6']}>
        <div class:list={[p.featured && 'md:col-span-8']}>
          <ConceptVisual variant={p.variant} class:list={[p.featured ? 'h-64 md:h-[420px]' : 'h-56 md:h-72']} />
          <p class="mt-2 text-xs text-slate">Imagen conceptual, no corresponde a un trabajo real.</p>
        </div>
        <div class:list={['mt-6 flex flex-col', p.featured && 'md:col-span-4 md:mt-0 md:justify-end']}>
          <div class="flex items-center gap-3 border-t border-charcoal pt-4 text-xs font-semibold tracking-[0.08em] text-charcoal">
            <span class="tabular-nums">{p.number}</span>
            <span class="text-slate" aria-hidden="true">/</span>
            <span class="uppercase">{p.category}</span>
          </div>
          <Heading level={3} font="display" class:list={['mt-4', p.featured ? 'md:text-[32px]' : 'text-2xl md:text-2xl']}>{p.title}</Heading>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate">{p.description}</p>
          <details class="group mt-4">
            <summary class="inline-flex min-h-11 cursor-pointer list-none items-center text-sm font-semibold text-charcoal underline decoration-primary decoration-2 underline-offset-4 transition-colors duration-200 hover:text-primary-hover [&::-webkit-details-marker]:hidden">
              <span>Ver proyecto <span class="sr-only">{p.number}</span></span><span aria-hidden="true" class="ml-2 text-primary">→</span>
            </summary>
            <p class="mt-2 max-w-sm border-l-2 border-primary pl-4 text-sm leading-relaxed text-charcoal">
              Este proyecto es un marcador de posición. El caso de estudio completo se publicará cuando esté disponible.
            </p>
          </details>
        </div>
      </article>
    ))}
  </div>
</Section>
